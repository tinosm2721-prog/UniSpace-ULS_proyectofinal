---
import BaseLayout from "../layouts/Layout.astro";
import Navbar from "@/components/navbar/navbar.astro";
import Sidebar from "@/components/Sidebar.astro";
import CampusMap from "@/components/vue/CampusMap.vue";
import { getUser } from "@/lib/auth-server";
import { getPublicaciones } from "@/lib/publicaciones-server";

const token = Astro.cookies.get("token")?.value;
if (!token) return Astro.redirect("/login");
const user = await getUser(token);

let actividades = [];
try {
  const pubs = await getPublicaciones(token, 1);
  actividades = Array.isArray(pubs?.data) ? pubs.data : Array.isArray(pubs) ? pubs : [];
} catch {}
---

<BaseLayout>
  <div class="navbar-fixed"><Navbar {...user} /></div>
  <aside class="sidebar-area"><Sidebar /></aside>
  <main class="page-main">
    <h1 class="text-3xl font-black mb-2">Mapa interactivo del campus</h1>
    <p class="mb-6 opacity-70">Aulas, edificios, cafetería y actividades del foro con su ubicación.</p>
    <CampusMap client:load actividades={actividades} />
  </main>
</BaseLayout>

<style>
  .navbar-fixed { position: sticky; top: 0; z-index: 40; }
  .sidebar-area { position: fixed; top: 90px; left: 18px; width: 220px; z-index: 30; }
  .page-main { max-width: 1100px; margin: 0 auto; padding: 100px 1.5rem 4rem; }
  @media (max-width: 768px) { .sidebar-area { display: none; } }
</style>
